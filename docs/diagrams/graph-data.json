    { "id": "http-fetch", "parentIds": ["load-items"], "label": "HTTP fetch", "sublabel": "Remote header/footer content", "layer": "external" },
    { "id": "terraform-output", "parentIds": ["load-items"], "label": "terraform output -json", "sublabel": "Runtime output values (subprocess)", "layer": "external" },
    { "id": "lock-file", "parentIds": ["load-items"], "label": ".terraform.lock.hcl", "sublabel": "Provider version resolution", "layer": "external" },
    { "id": "filesystem", "parentIds": ["file-writer", "reader-lines"], "label": "Filesystem", "sublabel": "Read .tf files, write docs", "layer": "external" },
    { "id": "plugin-subprocess", "parentIds": ["plugin-client"], "label": "Plugin subprocess", "sublabel": "External binary via go-plugin RPC", "layer": "external" }
  ]
